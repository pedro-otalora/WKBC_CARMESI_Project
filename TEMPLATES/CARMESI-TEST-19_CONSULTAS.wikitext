=== Búsqueda en cualquier campo ([https://carmesi-test-19.wikibase.cloud/query/#PREFIX%20p%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2F%3E%0APREFIX%20ps%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fstatement%2F%3E%0APREFIX%20pq%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fqualifier%2F%3E%0APREFIX%20Q_documento%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fentity%2FQ2%3E%0APREFIX%20Q_fondo%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fentity%2FQ6%3E%0APREFIX%20P_incluido_en%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fdirect%2FP3%3E%0APREFIX%20P_tipo_agrupacion_doc%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fdirect%2FP4%3E%0APREFIX%20P_id_origen%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fdirect%2FP8%3E%0APREFIX%20P_instanciacion_digital%3A%20%3Chttps%3A%2F%2Fcarmesi-test-19.wikibase.cloud%2Fprop%2Fdirect%2FP20%3E%0A%0ASELECT%20DISTINCT%20%3Fitem%20%3FitemLabel%20%3FidOrigen%20%3FfondoLabel%20%3Furl_PDF%20WHERE%20%7B%0A%20%20%0A%20%20%23%201.%20Definimos%20los%20t%C3%A9rminos%20que%20queremos%20buscar%20mediante%20VALUES%0A%20%20VALUES%20%3FterminoRaw%20%7B%20%22ENRIQUE%20III%22%20%7D%20%23%20Se%20pueden%20a%C3%B1adir%20m%C3%A1s%20t%C3%A9rminos%20aqu%C3%AD%3A%20%28%22enrique%20iii%22%20%22juana%20i%22%20%22toledo%22%29%0A%20%20%23%20Convierte%20din%C3%A1micamente%20el%20valor%20a%20min%C3%BAsculas%0A%20%20BIND%28LCASE%28STR%28%3FterminoRaw%29%29%20AS%20%3FterminoBuscado%29%0A%20%20%0A%20%20%23%202.%20Identificamos%20el%20documento%0A%20%20%3Fitem%20p%3AP1%20%3Fstatement%20.%0A%20%20%3Fstatement%20ps%3AP1%20Q_documento%3A%20.%0A%20%20%0A%20%20%23%203.%20Buscamos%20en%20cualquier%20propiedad%20de%20texto%20del%20%C3%ADtem%20de%20forma%20insensible%20a%20may%C3%BAsculas%0A%20%20%3Fitem%20%3Fpropiedad%20%3FtextoEncontrado%20.%0A%20%20FILTER%28isLiteral%28%3FtextoEncontrado%29%29%0A%20%20FILTER%28CONTAINS%28LCASE%28STR%28%3FtextoEncontrado%29%29%2C%20%3FterminoBuscado%29%29%0A%0A%20%20%23%204.%20Capturamos%20el%20identificador%20de%20origen%0A%20%20OPTIONAL%20%7B%20%20%0A%20%20%20%20%3Fitem%20P_id_origen%3A%20%3FidOrigen%20.%20%20%0A%20%20%7D%0A%0A%20%20%23%205.%20Navegamos%20hacia%20el%20Fondo%0A%20%20OPTIONAL%20%7B%20%20%0A%20%20%20%20%3Fitem%20P_incluido_en%3A%2B%20%3Ffondo%20.%0A%20%20%20%20%3Ffondo%20P_tipo_agrupacion_doc%3A%20%3FtipoAgrupacion%20.%0A%20%20%20%20FILTER%28%3FtipoAgrupacion%20%3D%20Q_fondo%3A%29%0A%20%20%7D%0A%0A%20%20%23%206.%20Capturamos%20el%20PDF%20de%20la%20instanciaci%C3%B3n%20digital%0A%20%20OPTIONAL%20%7B%20%20%0A%20%20%20%20%3Fitem%20P_instanciacion_digital%3A%20%3FinstanciacionDigital%20.%20%20%0A%20%20%20%20%3FinstanciacionDigital%20p%3AP12%20%3FurlStatement%20.%0A%20%20%20%20%3FurlStatement%20ps%3AP12%20%3Furl_PDF%20.%0A%20%20%20%20%3FurlStatement%20pq%3AP24%20%3Fmimetype%20.%0A%20%20%20%20FILTER%28CONTAINS%28LCASE%28STR%28%3Fmimetype%29%29%2C%20%22pdf%22%29%29%0A%20%20%7D%0A%0A%20%20SERVICE%20wikibase%3Alabel%20%7B%20bd%3AserviceParam%20wikibase%3Alanguage%20%22es%22.%20%7D%0A%7D%0AORDER%20BY%20%3FfondoLabel Enlace a la consulta]) ===
Búsqueda de una cadena en cualquier parte de un documento y listado de fondo asociado y url al objeto digital pdf de su instanciación.

En el ejemplo se pueden obtener los enlaces a los pdf de cualquier documento relacionado con "Enrique III". <syntaxhighlight lang="sparql">
PREFIX p: <https://carmesi-test-19.wikibase.cloud/prop/>
PREFIX ps: <https://carmesi-test-19.wikibase.cloud/prop/statement/>
PREFIX pq: <https://carmesi-test-19.wikibase.cloud/prop/qualifier/>
PREFIX Q_documento: <https://carmesi-test-19.wikibase.cloud/entity/Q2>
PREFIX Q_fondo: <https://carmesi-test-19.wikibase.cloud/entity/Q6>
PREFIX P_incluido_en: <https://carmesi-test-19.wikibase.cloud/prop/direct/P3>
PREFIX P_tipo_agrupacion_doc: <https://carmesi-test-19.wikibase.cloud/prop/direct/P4>
PREFIX P_id_origen: <https://carmesi-test-19.wikibase.cloud/prop/direct/P8>
PREFIX P_instanciacion_digital: <https://carmesi-test-19.wikibase.cloud/prop/direct/P20>

SELECT DISTINCT ?item ?itemLabel ?idOrigen ?fondoLabel ?url_PDF WHERE {

  # 1. Definimos los términos que queremos buscar mediante VALUES
  VALUES ?terminoRaw { "ENRIQUE III" } # Se pueden añadir más términos aquí: ("enrique iii" "juana i" "toledo")
  # Convierte dinámicamente el valor a minúsculas
  BIND(LCASE(STR(?terminoRaw)) AS ?terminoBuscado)

  # 2. Identificamos el documento
  ?item p:P1 ?statement .
  ?statement ps:P1 Q_documento: .

  # 3. Buscamos en cualquier propiedad de texto del ítem de forma insensible a mayúsculas
  ?item ?propiedad ?textoEncontrado .
  FILTER(isLiteral(?textoEncontrado))
  FILTER(CONTAINS(LCASE(STR(?textoEncontrado)), ?terminoBuscado))

  # 4. Capturamos el identificador de origen
  OPTIONAL {
    ?item P_id_origen: ?idOrigen .
  }

  # 5. Navegamos hacia el Fondo
  OPTIONAL {
    ?item P_incluido_en:+ ?fondo .
    ?fondo P_tipo_agrupacion_doc: ?tipoAgrupacion .
    FILTER(?tipoAgrupacion = Q_fondo:)
  }

  # 6. Capturamos el PDF de la instanciación digital
  OPTIONAL {
    ?item P_instanciacion_digital: ?instanciacionDigital .
    ?instanciacionDigital p:P12 ?urlStatement .
    ?urlStatement ps:P12 ?url_PDF .
    ?urlStatement pq:P24 ?mimetype .
    FILTER(CONTAINS(LCASE(STR(?mimetype)), "pdf"))
  }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "es". }
}
ORDER BY ?fondoLabel
</syntaxhighlight>

