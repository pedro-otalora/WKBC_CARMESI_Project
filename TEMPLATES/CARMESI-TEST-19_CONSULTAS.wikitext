Listado de todos los Agentes ordenado por número de aparición sean del tipo persona, institución<syntaxhighlight lang="sparql">PREFIX P_productor: <https://carmesi-test-19.wikibase.cloud/prop/direct/P17>
PREFIX P_institucion: <https://carmesi-test-19.wikibase.cloud/prop/direct/P16>
PREFIX P_persona: <https://carmesi-test-19.wikibase.cloud/prop/direct/P15>

SELECT ?agente ?agenteLabel ?tipoAgenteLabel (COUNT(?documento) AS ?frecuencia)
WHERE {
  {
    {
      ?documento P_institucion: ?agente .
      BIND("Institución" AS ?tipoAgenteLabel)
    }
    UNION
    {
      ?documento P_persona: ?agente .
      BIND("Persona" AS ?tipoAgenteLabel)
    }
    UNION
    {
      ?documento P_productor: ?agente .
      BIND("Productor" AS ?tipoAgenteLabel)
    }
  }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "es". }
}
GROUP BY ?agente ?agenteLabel ?tipoAgenteLabel
ORDER BY DESC(?frecuencia)</syntaxhighlight>

