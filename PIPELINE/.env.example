# Copie este fichero como ".env" (mismo directorio que config_carmesi.py)
# y rellene sus valores reales. El fichero ".env" NUNCA debe subirse a un
# repositorio ni compartirse — añádalo a .gitignore.

CARMESI_WIKIBASE_INSTANCE=carmesi-test-15
CARMESI_BOT_USER=admin
CARMESI_BOT_PASSWORD=su_contraseña_aqui

# Opcional: ruta local del pipeline. Si no se define, se usa la misma
# carpeta donde está config_carmesi.py (LOAD_FILES y EXTRACT_FILES se crean
# ahí dentro). Defínala solo si quiere separar código y datos.
# CARMESI_PIPELINE_PATH=/ruta/a/su/proyecto
